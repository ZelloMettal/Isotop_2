<Window x:Class="Isotop2.Forms.SearchForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Isotop2.Forms"
        mc:Ignorable="d"
        ResizeMode="CanMinimize"
        Title="Поиск" Height="220" Width="430"
        Icon="/Resources/find.jpg"
        Loaded="SearchForm_Load"
        KeyDown="PressHotKey">

    <Window.Resources>
        <Style x:Key="Top">
            <Setter Property="ItemsControl.VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="LeftTop" BasedOn="{StaticResource ResourceKey=Top}">
            <Setter Property="ItemsControl.HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="RightTop" BasedOn="{StaticResource ResourceKey=Top}">
            <Setter Property="ItemsControl.HorizontalAlignment" Value="Right"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="IsThreeState" Value="False"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <StackPanel Style="{StaticResource LeftTop}" Height="150">
            <RadioButton Name="radioButton_ByColumns" Content="Колонки" IsChecked="True" Checked="radioButton_ByColumns_CheckedChanged" Margin="10,15,0,5"/>
            <RadioButton Name="radioButton_ByGenerator" Content="Номер генератора" Checked="radioButton_ByGenerator_CheckedChanged" Margin="10,5,0,0"/>
            <RadioButton Name="radioButton_ByPassport" Content="Номер паспорта" Checked="radioButton_ByPassport_CheckedChanged" Margin="10,10,0,0"/>
            <RadioButton Name="radioButton_ByDate" Content="Дата изготовления" Checked="radioButton_ByDate_CheckedChanged" Margin="10,10,0,0"/>
            <RadioButton Name="radioButton_BySent" Content="Отправлен" Checked="radioButton_BySent_CheckedChanged" Margin="10,10,0,0"/>
        </StackPanel>
        <ComboBox Style="{StaticResource LeftTop}" Name="comboBox_ColumnName" Width="130" SelectionChanged="comboBox_ColumnName_SelectedChanged" Margin="140,10,0,0"/>
        <ComboBox Style="{StaticResource RightTop}" Name="comboBox_Search" Width="130" Margin="0,10,10,0"/>
        <TextBox Style="{StaticResource LeftTop}" Name="textBox_NumberGeneration" Width="130" IsEnabled="False" Margin="140,40,0,0"/>
        <TextBox Style="{StaticResource LeftTop}" Name="textBox_PassportNumber" Width="130" IsEnabled="False" Margin="140,65,0,0"/>
        <DatePicker Style="{StaticResource LeftTop}" Name="datePicker_StartDate" Width="130" IsEnabled="False" Margin="140,90,0,0"/>
        <DatePicker Style="{StaticResource RightTop}" Name="datePicker_EndDate" Width="130" IsEnabled="False" Margin="0,90,10,0"/>
        <CheckBox Style="{StaticResource LeftTop}" Name="checkBox_Sent" Content="Отправлен" IsEnabled="False" IsThreeState="False" Margin="140,120,0,0"/>
        <Button Name="button_Search" Click="button_Search_Click" Content="Найти" Margin="0,0,80,10"/>
        <Button Name="button_Cancel" Click="button_Cancel_Click" Content="Отмена" Margin="0,0,10,10"/>
    </Grid>
</Window>
