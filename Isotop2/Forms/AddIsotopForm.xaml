<Window x:Class="Isotop2.Forms.AddIsotopForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Isotop2.Forms"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="Добавление" Height="130" Width="320"
        Icon="/Resources/add.jpg"
        KeyDown="PressHotKey">
    
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="130"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="ItemsControl.HorizontalAlignment" Value="Left"/>
            <Setter Property="ItemsControl.VerticalAlignment" Value="Top"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Label Grid.Column="0" Name="label_Day" Content="Период" Margin="5,5,0,0"/>
        <TextBox Grid.Column="0" Name="textBox_Day" PreviewTextInput="NumberValidationTextBox" Margin="10,30,10,0"/>
        <Label Grid.Column="1" Name="label_PrecentOfDecay" Content="Процент распада" Margin="5,5,0,0"/>
        <TextBox Grid.Column="1" Name="textBox_PrecentOfDecay" PreviewTextInput="NumberWithDotValidationTextBox" Margin="10,30,10,0"/>
        <Button Grid.Column="1" Name="button_OK" Content="Добавить" Click="button_OK_Click" Margin="0,0,80,10"/>
        <Button Grid.Column="1" Name="button_Cancel" Content="Отмена" Click="button_Cancel_Click" Margin="0,0,15,10"/>
    </Grid>
</Window>
