<Window x:Class="Isotop2.Forms.TechnetiumPrintForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Isotop2.Forms"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="Печать" Height="470" Width="260"
        Icon="/Resources/print.jpg"
        Loaded="TechnetiumPrintForm_Load"
        KeyDown="PressHotKey">

    <Window.Resources>
        <Style TargetType="ListView">
            <Setter Property="Height" Value="150"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="BaseButton">
            <Setter Property="ItemsControl.Width" Value="50"/>
            <Setter Property="ItemsControl.VerticalAlignment" Value="Bottom"/>
        </Style>
        <Style x:Key="ButtonRight" BasedOn="{StaticResource ResourceKey=BaseButton}">
            <Setter Property="ItemsControl.HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="ButtonLeft" BasedOn="{StaticResource ResourceKey=BaseButton}">
            <Setter Property="ItemsControl.HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="Top">
            <Setter Property="ItemsControl.VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="TopLeft" BasedOn="{StaticResource ResourceKey=Top}">
            <Setter Property="ItemsControl.HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="TopRight" BasedOn="{StaticResource ResourceKey=Top}">
            <Setter Property="ItemsControl.HorizontalAlignment" Value="Right"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Style="{StaticResource ResourceKey=TopLeft}" Name="label_CurrentData" Content="Текущая дата :" Margin="5,0,0,0"/>
        <Label Grid.Row="0" Style="{StaticResource ResourceKey=TopLeft}" Name="label_Adult" Content="Взрослые" Margin="5,30,0,0"/>
        <CheckBox Grid.Row="0" Style="{StaticResource ResourceKey=TopRight}" Name="checkBox_PrintAdult" Content="Добавить в печать" IsThreeState="False" IsChecked="True" Margin="0,35,10,0"/>
        <ListView Grid.Row="0" Name="listView_Adult" Margin="10,55,10,0">
            <ListView.View>
                <GridView>
                    <GridView.Columns>
                        <GridViewColumn Header="Маркера" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Path=MarkerName}" IsChecked ="{Binding Path=IsChecked}" IsThreeState="False"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Объём" DisplayMemberBinding="{Binding Path=Volume}" Width="55"/>
                        <GridViewColumn Header="Активность" DisplayMemberBinding="{Binding Path=Activity}" Width="70"/>
                    </GridView.Columns>
                </GridView>
            </ListView.View>
        </ListView>
        <Label Grid.Row="1" Style="{StaticResource ResourceKey=TopLeft}" Name="label_Children" Content="Дети" Margin="5,0,0,0"/>
        <CheckBox Grid.Row="1" Style="{StaticResource ResourceKey=TopRight}" Name="checkBox_PrintChildren" Content="Добавить в печать" IsThreeState="False" Margin="0,5,10,0"/>
        <ListView Grid.Row="1" Name="listView_Children" Margin="10,30,10,0">
            <ListView.View>
                <GridView>
                    <GridView.Columns>
                        <GridViewColumn Header="Маркера"  Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Path=MarkerName}" IsChecked ="{Binding Path=IsChecked}" IsThreeState="False"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Объём" DisplayMemberBinding="{Binding Path=Volume}" Width="55"/>
                        <GridViewColumn Header="Активность" DisplayMemberBinding="{Binding Path=Activity}" Width="70"/>
                    </GridView.Columns>
                </GridView>
            </ListView.View>
        </ListView>
        <Button Grid.Row="1" Style="{StaticResource ResourceKey=ButtonLeft}" Name="button_Print" Content="Печать" Click="button_Print_Click" Margin="10,0,0,10"/>
        <Button Grid.Row="1" Style="{StaticResource ResourceKey=ButtonRight}" Name="button_Cancel" Content="Отмена" Click="button_Cancel_Click" Margin="0,0,10,10"/>
    </Grid>
</Window>