<Window x:Class="Isotop2.Forms.RIForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Isotop2.Forms"
        mc:Ignorable="d"
        Name="RIFormName"
        Title="РИ" Height="450" Width="800"
        Icon="/Resources/radiation .jpg"
        Loaded="RIForm_Load">

    <Window.Resources>
        <Style x:Key="ButtonSearchAndExpotr" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>        
    </Window.Resources>
        
        <Grid>
        <Button Style="{StaticResource ButtonSearchAndExpotr}" Name="button_Search" Click="button_Search_Click" Margin="10,10,0,0">
                <Image Source="/Resources/find.jpg"/>
            </Button>
            <Button Style="{StaticResource ButtonSearchAndExpotr}" Name="button_DropSearch" Click="button_DropSearch_Click" Margin="50,10,0,0">
                <Image Source="/Resources/drop_find.jpg"/>
            </Button>
            <Button Style="{StaticResource ButtonSearchAndExpotr}" Name="button_ExportToExcel" Click="button_ExportToExcel_Click" Margin="90,10,0,0">
                <Image Source="/Resources/excel.jpg"/>
            </Button>
            <Button Name="button_Add" Click="button_Add_Click" Content="Добавить" Margin="0,20,150,0"/>
            <Button Name="button_Edit" Click="button_Edit_Click" Content="Изменить" Margin="0,20,80,0"/>
            <Button Name="button_Delete" Click="button_Delete_Click" Content="Удалить" Margin="0,20,10,0"/>
            <DataGrid Name="dataGrid_RIList" SelectedCellsChanged="dataGrid_RIList_CellClick" SelectionMode="Single" SelectionUnit="FullRow" IsReadOnly="True" Margin="10,45,10,10"/>
        </Grid>
</Window>
