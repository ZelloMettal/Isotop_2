<Window x:Class="Isotop2.Forms.AddUserForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Isotop2.Forms"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="Добавоение" Height="250" Width="260"
        Icon="/Resources/add.jpg"
        KeyDown="PressHotKey">

    <Window.Resources>
        <Style x:Key="StyleBoxes">
            <Setter Property="ItemsControl.HorizontalAlignment" Value="Left"/>
            <Setter Property="ItemsControl.VerticalAlignment" Value="Top"/>
            <Setter Property="ItemsControl.Width" Value="220"/>
        </Style>
        <Style x:Key="BaseButton">
            <Setter Property="ItemsControl.Width" Value="60"/>
            <Setter Property="ItemsControl.VerticalAlignment" Value="Bottom"/>
        </Style>        
        <Style x:Key="ButtonRight" BasedOn="{StaticResource ResourceKey=BaseButton}">
            <Setter Property="ItemsControl.HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="ButtonLeft" BasedOn="{StaticResource ResourceKey=BaseButton}">
            <Setter Property="ItemsControl.HorizontalAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Name="label_UserName" Content="Имя пользователя" Margin="5,5,0,0"/>
        <TextBox Grid.Row="0" Style="{StaticResource ResourceKey=StyleBoxes}" Name="textBox_UserName" TabIndex="0" Margin="10,30,0,0"/>
        <Label Grid.Row="1" Name="label_Password" Content="Пароль" Margin="5,5,0,0"/>
        <TextBox Grid.Row="1" Style="{StaticResource ResourceKey=StyleBoxes}" Name="textBox_Password" Visibility="Hidden" TabIndex="1" Margin="10,30,0,0"/>
        <CheckBox Grid.Row="1" Name="checkBox_ShowPassword" Content="Показать пароль" Checked="checkBox_ShowPassword_Checked" Unchecked="checkBox_ShowPassword_Unchecked" IsThreeState="False" Margin="0,10,20,0" VerticalAlignment="Top" HorizontalAlignment="Right"/>
        <PasswordBox Grid.Row="1" Style="{StaticResource ResourceKey=StyleBoxes}" Name="passworBox_Password" TabIndex="1" Margin="10,30,0,0"/>
        <Label Grid.Row="2" Name="label_ConfirmPassword" Content="Подтверждение пароля" Margin="5,0,0,0" HorizontalAlignment="Left"/>
        <TextBox Grid.Row="2" Style="{StaticResource ResourceKey=StyleBoxes}" Name="textBox_ConfirmPassword" TabIndex="3" Visibility="Hidden" Margin="10,25,0,0"/>
        <PasswordBox Grid.Row="2" Style="{StaticResource ResourceKey=StyleBoxes}" Name="passworBox_ConfirmPassword" TabIndex="2" Margin="10,25,0,0"/>
        <CheckBox Grid.Row="2" Name="checkBox_Administrator" Content="Администартор" IsThreeState="False" TabIndex="3" Margin="10,50,0,0"/>
        <Button Grid.Row="2" Style="{StaticResource ResourceKey=ButtonLeft}" Name="button_Cancel" Content="Отмена" Click="button_Cancel_Click" Margin="10,0,0,0"/>
        <Button Grid.Row="2" Style="{StaticResource ResourceKey=ButtonRight}" Name="button_OK" Content="Добавить" Click="button_OK_Click" Margin="0,0,15,0"/>
    </Grid>
</Window>
