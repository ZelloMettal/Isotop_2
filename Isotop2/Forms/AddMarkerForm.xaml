<Window x:Class="Isotop2.Forms.AddMarkerForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Isotop2.Forms"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="Добавление" Height="150" Width="580"
        Icon="/Resources/add.jpg"
        KeyDown="PressHotKey">
    
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="120"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="ItemsControl.HorizontalAlignment" Value="Left"/>
            <Setter Property="ItemsControl.VerticalAlignment" Value="Top"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>        
        <Label Grid.Column="0" Name="label_Name" Content="Маркер" Margin="5,5,0,0"/>
        <TextBox Grid.Column="0" Name="textBox_Name" Margin="10,30,0,0"/>
        <Label Grid.Column="1" Name="label_MaxActivity" Content="Макс.Активность" Margin="5,5,0,0"/>
        <TextBox Grid.Column="1" Name="textBox_MaxActivity" PreviewTextInput="NumberValidationTextBox" Margin="10,30,0,0"/>
        <Label Grid.Column="2" Name="label_MinActivity" Content="Мин.Активность" Margin="5,5,0,0"/>
        <TextBox Grid.Column="2" Name="textBox_MinActivity" PreviewTextInput="NumberValidationTextBox" Margin="10,30,0,0"/>
        <CheckBox Grid.Column="3" Name="checkBox_IsNewGenerator" Content="Новый генератор" IsThreeState="False" Margin="5,30,10,0"/>
        <Button Grid.Column="3" Name="button_OK" Content="Добавить" Click="button_OK_Click" Margin="0,0,80,10"/>
        <Button Grid.Column="3" Name="button_Cancel" Content="Отмена" Click="button_Cancel_Click" Margin="0,0,10,10"/>
    </Grid>
</Window>
