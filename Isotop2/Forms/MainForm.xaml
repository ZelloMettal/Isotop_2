<Window x:Class="Isotop2.MainForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Isotop2"
        mc:Ignorable="d"
        Name="MainFormName"
        Title="Изотоп 2.0" Height="780" Width="1080"
        Icon="/Resources/radiation.jpg"
        ResizeMode="CanMinimize"
        Closed="MainForm_FormClosed"
        Loaded="MainForm_Load">

    <Window.Resources>
        <Style x:Key="ButtonPrint" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="Top">
            <Setter Property="ItemsControl.VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="TopLeft" BasedOn="{StaticResource ResourceKey=Top}">
            <Setter Property="ItemsControl.HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="TopRight" BasedOn="{StaticResource ResourceKey=Top}">
            <Setter Property="ItemsControl.HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="TopCenter" BasedOn="{StaticResource ResourceKey=Top}">
            <Setter Property="ItemsControl.HorizontalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Width" Value="130"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="GridMainForm">
        <Menu Name="menu_MainMenu" Height="20" VerticalAlignment="Top">
            <MenuItem Header="Файл">
                <MenuItem Name="manuItem_ChangeUser" Header="Сменить пользователя" Click="menuItem_ChangeUser_Click"></MenuItem>
                <Separator/>
                <MenuItem Name="menuItem_Exit" Header="Выход" Click="menuItem_Exit_Click"></MenuItem>
            </MenuItem>
            <MenuItem Header="Инструменты">
                <MenuItem Name="menuItem_OpenFormData" Header="База данных" Click="menuItem_OpenFormData_Click"></MenuItem>
                <MenuItem Name="menuItem_OpenFormRI" Header="РИ" Click="menuItem_OpenFormRI_Click"></MenuItem>
            </MenuItem>
        </Menu>
        <TabControl Name="tabControl_MainForm" Margin="0,20,0,0">
            <TabItem Name="tabItem_Technetium" Header="Технеций">
                <Grid Background="#FFE5E5E5" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="410"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="550"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Style="{StaticResource ResourceKey=TopLeft}" Name="label_ActivityNewGeneration" Content="Новый генератор, МБк" Margin="35,25,0,0"/>
                    <ListView Grid.Column="0" Name="listView_CalculateNewGeneration" Width="190" Margin="10,80,0,10" HorizontalAlignment="Left">
                        <ListView.View>
                            <GridView>
                                <GridView.Columns>
                                    <GridViewColumn Header="Объём, Мл" DisplayMemberBinding="{Binding Path=Volume}" Width="80"/>
                                    <GridViewColumn Header="Активность, МБк" DisplayMemberBinding="{Binding Path=Activity}" Width="100"/>
                                </GridView.Columns>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <Label Grid.Column="0" Style="{StaticResource ResourceKey=TopRight}" Name="label_ActivityOldGeneration" Content="Старый генератор, МБк" Margin="0,25,35,0"/>
                    <ListView Grid.Column="0" Name="listView_CalculateOldGeneration" Width="190" Margin="0,80,10,10" HorizontalAlignment="Right">
                        <ListView.View>
                            <GridView>
                                <GridView.Columns>
                                    <GridViewColumn Header="Объём, Мл" DisplayMemberBinding="{Binding Path=Volume}" Width="80"/>
                                    <GridViewColumn Header="Активность, МБк" DisplayMemberBinding="{Binding Path=Activity}" Width="100"/>
                                </GridView.Columns>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBox Grid.Column="0" Style="{StaticResource ResourceKey=TopLeft}" Name="textBox_ActivityNewGeneration" PreviewTextInput="NumberValidationTextBox" TextChanged="textBox_ActivityNewGeneration_ValueChanged" Width="190" Margin="10,50,0,0"/>
                    <TextBox Grid.Column="0" Style="{StaticResource ResourceKey=TopRight}" Name="textBox_ActivityOldGeneration" PreviewTextInput="NumberValidationTextBox" TextChanged="textBox_ActivityOldGeneration_ValueChanged" Width="190" Margin="0,50,10,0"/>
                    <Label Grid.Column="1" Style="{StaticResource ResourceKey=TopCenter}" Name="label_TimeOfDecay" Content="Время распада:" Margin="0,25,0,0"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource ResourceKey=TopCenter}" Name ="textBlock_Hour" Text="0 час." Margin="0,55,0,0"/>
                    <Slider Grid.Column="1" Style="{StaticResource ResourceKey=TopCenter}" Name="slider_TimeOfDecay" ValueChanged="slider_TimeOfDecay_ValueChanged" Maximum="12" Minimum="0" SmallChange="0.5" LargeChange="0.5" TickFrequency="0.5" Width="35" Height="300" Margin="0,80,0,0" Orientation="Vertical" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Foreground="#FF646464"/>
                    <ListView Grid.Column="2" Name="listView_EstimatedActivitybyAdults" Width="260" Margin="5,80,0,10" HorizontalAlignment="Left">
                        <ListView.View>
                            <GridView>
                                <GridView.Columns>
                                    <GridViewColumn Header="Маркер" DisplayMemberBinding="{Binding Path=MarkerName}" Width="80"/>
                                    <GridViewColumn Header="Объём, Мл" DisplayMemberBinding="{Binding Path=Volume}" Width="70"/>
                                    <GridViewColumn Header="Активность, МБк" DisplayMemberBinding="{Binding Path=Activity}" Width="100"/>
                                </GridView.Columns>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <ListView Grid.Column="2" Name="listView_EstimatedActivitybyChildren" Width="260" Margin="0,80,5,10" HorizontalAlignment="Right">
                        <ListView.View>
                            <GridView>
                                <GridView.Columns>
                                    <GridViewColumn Header="Маркер" DisplayMemberBinding="{Binding Path=MarkerName}" Width="80"/>
                                    <GridViewColumn Header="Объём, Мл" DisplayMemberBinding="{Binding Path=Volume}" Width="70"/>
                                    <GridViewColumn Header="Активность, МБк" DisplayMemberBinding="{Binding Path=Activity}" Width="100"/>
                                </GridView.Columns>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <Label Grid.Column="2" Style="{StaticResource ResourceKey=TopCenter}" Name="label_EstimatedActivity" Content="Расчёт активность по маркерам" Margin="0,20,0,0"/>
                    <Label Grid.Column="2" Style="{StaticResource ResourceKey=TopLeft}" Name="label_Adults" Content="Взрослые" Margin="0,45,0,0"/>
                    <Label Grid.Column="2" Style="{StaticResource ResourceKey=TopCenter}" Name="label_Children" Content="Дети" Margin="50,45,0,0"/>
                    <ComboBox Grid.Column="2" Style="{StaticResource ResourceKey=TopRight}" Name="comboBox_ChildrenAge" SelectionChanged="comboBox_ChildrenAge_SelectedChanged" Width="120" Margin="0,45,10,0"/>
                    <Button Grid.Column="2" Style="{StaticResource ButtonPrint}" Name="button_PrintTechnetium" Click="button_PrintTechnetium_Click" Margin="0,5,10,0">
                        <Image Source="/Resources/print.jpg"/>
                    </Button>
                </Grid>
            </TabItem>
            <TabItem Name="tabItem_Iodine" Header="Йод">
                <Grid Background="#FFE5E5E5" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="450"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="1" Style="{StaticResource ResourceKey=TopLeft}" Name="label_DateOnDayZero" Content="Дата на нулевой день" Margin="15,5,0,0" HorizontalAlignment="Left"/>
                    <DatePicker Grid.Column="1" Name="datePicker_DateOnDayZeroIodine" SelectedDateChanged="datePicker_DateOnDayZeroIodine_SelectionDataChanged" Margin="20,30,0,0"/>
                    <Label Grid.Column="1" Style="{StaticResource ResourceKey=TopCenter}" Name="label_ActivityIodine" Content="Активность, МБк" Margin="-35,5,0,0"/>
                    <TextBox Grid.Column="1" Style="{StaticResource ResourceKey=TopCenter}" Name="textBox_IodineActivity" PreviewTextInput="NumberValidationTextBox" TextChanged="textBox_ActivityIodine_ValueChanged" Width="120" Margin="-10,32,0,0"/>
                    <ListView Grid.Column="1" Name="listView_CalculationIodine" Width="410" HorizontalAlignment="Center" Margin="0,65,0,10" >
                        <ListView.View>
                            <GridView>
                                <GridView.Columns>
                                    <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding Path=Date}" Width="70"/>
                                    <GridViewColumn Header="День" DisplayMemberBinding="{Binding Path=Day}"  Width="40"/>
                                    <GridViewColumn Header="Процент распада" DisplayMemberBinding="{Binding Path=DecayPrecent}" Width="105"/>
                                    <GridViewColumn Header="Активность, МБк" DisplayMemberBinding="{Binding Path=Activity}" Width="100"/>
                                    <GridViewColumn Header="Объём, Мл" DisplayMemberBinding="{Binding Path=Volume}" Width="80"/>
                                </GridView.Columns>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <Button Grid.Column="1" Style="{StaticResource ButtonPrint}" Name="button_PrintIodine" Click="button_PrintIodune_Click" Margin="0,20,20,0" HorizontalAlignment="Right">
                        <Image Source="/Resources/print.jpg"/>
                    </Button>
                </Grid>
            </TabItem>
            <TabItem Name="tabItem_Radium" Header="Радий" Height="20" VerticalAlignment="Top">
                <Grid Background="#FFE5E5E5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="190"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Style="{StaticResource ResourceKey=TopLeft}" Name="label_ActivityRadium" Content="Активность, МБк" Margin="85,5,0,0" />
                    <TextBox Grid.Column="0" Style="{StaticResource ResourceKey=TopLeft}" Name="textBox_ActivityRadium" PreviewTextInput="NumberValidationTextBoxWithDot" TextChanged="textBox_ActivityRadium_TextChanged" Width="120" Margin="90,30,0,0"/>
                    <ListView Grid.Column="0" Name="listView_CalculationRadium" Width="230" Margin="0,60,0,10" HorizontalAlignment="Right" >
                        <ListView.View>
                            <GridView>
                                <GridView.Columns>
                                    <GridViewColumn Header="День" DisplayMemberBinding="{Binding Path=Day}" Width="40"/>
                                    <GridViewColumn Header="Коэффицент" DisplayMemberBinding="{Binding Path=Coefficent}" Width="80"/>
                                    <GridViewColumn Header="Активность, МБк" DisplayMemberBinding="{Binding Path=Activity}" Width="100"/>
                                </GridView.Columns>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <Label Grid.Column="1" Name="label_CreateDate" Content="Дата изготовления" Margin="15,5,0,0"/>
                    <DatePicker Grid.Column="1" Name="datePicker_CreateDateRadium" SelectedDateChanged="datePicker_CreateDateRadium_SelectionDataChanged" Margin="20,30,0,0"/>
                    <Label Grid.Column="2" Style="{StaticResource ResourceKey=TopLeft}" Name="label_CurrentDate" Content="Текущая дата" Margin="0,5,0,0"/>
                    <DatePicker Grid.Column="2" Name="datePicker_CurrentDateRadium" SelectedDateChanged="datePicker_CurrentDateRadium_SelectionDataChanged" Margin="5,30,0,0"/>
                    <Label Grid.Column="2" Style="{StaticResource ResourceKey=TopRight}" Name="label_PatientWeight" Content="Вес пациента, Кг" Margin="0,5,65,0"/>
                    <TextBox Grid.Column="2" Style="{StaticResource ResourceKey=TopRight}" Name="textBox_PatientWeightRadium" PreviewTextInput="NumberValidationTextBox" TextChanged="textBox_PatientWeightRadium_ValueChanged" Width="120" Margin="0,30,40,0"/>
                    <TextBlock Style="{StaticResource ResourceKey=TopRight}" Grid.Column="2" Grid.ColumnSpan="2" Name="textBlock_Warning" Height="20" Width="190" Margin="0,20,20,0" Foreground="#FFFD0000"/>
                    <ListView Grid.Column="1" Style="{StaticResource ResourceKey=TopLeft}" Grid.ColumnSpan="3" Name="listView_CalculationActivityRadium" Height="80" Margin="20,60,0,0">
                        <ListView.View>
                            <GridView>
                                <GridView.Columns>
                                    <GridViewColumn Header="Разность в датах" DisplayMemberBinding="{Binding Path=DifferenceDays}" Width="100"/>
                                    <GridViewColumn Header="Текущий коэффицент" DisplayMemberBinding="{Binding Path=CurrentCoefficent}" Width="130"/>
                                    <GridViewColumn Header="Текущая активность, МБк" DisplayMemberBinding="{Binding Path=CurrentActivity}" Width="150"/>
                                    <GridViewColumn Header="Объём, Мл" DisplayMemberBinding="{Binding Path=Volume}" Width="70"/>
                                    <GridViewColumn Header="Активность в объёме, КБк" DisplayMemberBinding="{Binding Path=ActivityInVolume}" Width="160"/>
                                </GridView.Columns>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <Button Grid.Column="2" Style="{StaticResource ResourceKey=TopLeft}" Name="button_AddPatient" Content="Добавить пациента" Click="button_AddPatient_Click" Width="120" Margin="0,160,0,0"/>
                    <Button Grid.Column="2" Style="{StaticResource ResourceKey=TopLeft}" Name="button_DeletePatient" Content="Удалить пациента" Click="button_DeletePatient_Click" Width="120" Margin="130,160,0,0"/>
                    <Button Grid.Column="2" Style="{StaticResource ButtonPrint}" Name="button_Printadium" Click="button_PrintRadium_Click" Margin="0,150,0,0">
                        <Image Source="/Resources/print.jpg"/>
                    </Button>
                    <ListView Grid.Column="2" Name="listView_RadiumPatientList" KeyDown="listView_RadiumPatientList_KeyDown" Width="320" Margin="0,190,0,10" HorizontalAlignment="Left">
                        <ListView.View>
                            <GridView>
                                <GridView.Columns>
                                    <GridViewColumn Header="Имя пациента" DisplayMemberBinding="{Binding Path=PatientName}" Width="90"/>
                                    <GridViewColumn Header="Вес, Кг" DisplayMemberBinding="{Binding Path=Weight}" Width="50"/>
                                    <GridViewColumn Header="Объём, Мл" DisplayMemberBinding="{Binding Path=Volume}" Width="70"/>
                                    <GridViewColumn Header="Активность, КБк" DisplayMemberBinding="{Binding Path=Activity}" Width="100"/>
                                </GridView.Columns>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>