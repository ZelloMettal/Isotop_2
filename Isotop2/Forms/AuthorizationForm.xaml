<Window x:Class="Isotop2.Forms.AuthorizationForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Isotop2"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="Авторизация" Height="170" Width="270"
        Icon="/Resources/radiation .jpg"
        KeyDown="PressHotKey">
    
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </Window.Resources>    
    
    <Grid>
        <Label Name="label_UserName" Content="Имя пользователя" Margin="5,5,0,0"/>
        <TextBox Name="textBox_UserName" TabIndex="0" Margin="10,30,10,0"/>
        <Label Name="label_Password" Content="Пароль" Margin="5,50,0,0"/>
        <TextBox Name="textBox_UserPassword" Visibility="Hidden" Margin="10,75,10,0"/>
        <PasswordBox Name="passwordBox_UserPassword" TabIndex="1" Margin="10,75,10,0"/>
        <CheckBox Name="checkBox_ShowPassword" Content="Показать пароль" Checked="checkBox_ShowPassword_Checked" Unchecked="checkBox_ShowPassword_Uncheked" Margin="0,55,10,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
        <Button Name="button_OK" TabIndex="2" Click="button_OK_Click" Content="Войти" Margin="10,0,0,10" HorizontalAlignment="Left"/>
        <Button Name="button_Cancel" Content="Отмена" Click="button_Cancel_Click" Margin="0,0,10,10" HorizontalAlignment="Right"/>
    </Grid>
</Window>
